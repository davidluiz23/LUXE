{
  "name": "alkebulan-storefront",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:heritage": "node scripts/build-heritage.cjs",
    "dev": "node scripts/serve.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.cjs",
    "build": "node scripts/build-african-modern.cjs",
    "build:home": "node scripts/build-african-modern.cjs --home-only",
    "build:world": "node scripts/build-world.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "supabase": "2.117.0"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.186.0"
  }
}
