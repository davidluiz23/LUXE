# Shared edge-function configuration
BRAND_NAME=ALKEBULAN
LUXE_SITE_URL=https://your-store.example
LUXE_ALLOWED_ORIGINS=https://your-store.example,http://localhost:5500
# Hosted Edge Functions receive a named SUPABASE_SECRET_KEYS map automatically.
# Keep this set to an explicit key name; never select a key by JSON order.
LUXE_SUPABASE_SECRET_KEY_NAME=default

# Web Push (generate once with: npx web-push generate-vapid-keys)
# Keep the private key only in Supabase Edge Function secrets.
WEB_PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@your-store.example

# WhatsApp Cloud API (templates are recommended for proactive messages)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=2348012345678
WHATSAPP_DEFAULT_COUNTRY_CODE=234
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_VERIFICATION_TEMPLATE=luxe_verification_code
WHATSAPP_VERIFICATION_TEMPLATE_LANGUAGE=en
WHATSAPP_VERIFICATION_COPY_CODE_BUTTON=true
# Generate a separate random value of at least 32 characters. Never reuse an API token.
WHATSAPP_OTP_SECRET=
WHATSAPP_ADMIN_ORDER_TEMPLATE=
WHATSAPP_CUSTOMER_ORDER_TEMPLATE=
WHATSAPP_CUSTOMER_UPDATE_TEMPLATE=
WHATSAPP_ADMIN_PAYMENT_TEMPLATE=
WHATSAPP_ADMIN_CUSTOMER_MESSAGE_TEMPLATE=

# Signup verification and individual customer email delivery through Brevo.
# Use a sender address/domain that has been verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=updates@your-verified-domain.example
BREVO_SENDER_NAME=ALKEBULAN

# Optional but recommended signup abuse protection. Set the matching public
# site key in Frontend/js/brand-config.js before enabling the requirement.
TURNSTILE_SECRET_KEY=
REQUIRE_SIGNUP_CAPTCHA=false

# Cloudinary product media. API secret stays inside the signing Edge Function.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=alkebulan/products

# Random value of at least 32 characters used only by the scheduled
# commerce-maintenance invocation.
COMMERCE_MAINTENANCE_SECRET=

# Optional comma-separated additions to the built-in browser push endpoint
# allowlist. Use hostnames only, never arbitrary URLs.
WEB_PUSH_ALLOWED_HOSTS=

# Paystack provider plug. Keep false until the client enables online payments.
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer
PAYSTACK_CALLBACK_URL=https://your-store.example/dashboard.html?payment=return
